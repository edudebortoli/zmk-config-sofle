 *
 * SPDX-License-Identifier: MIT
 *
 * Sofle keymap simulating a Corne 36 (3x5 + 3 thumbs per side).
 * Physical keys not present on a real Corne 36 are bound to &none:
 *   - the whole number row (row 1)
 *   - the outer pinky column on rows 2-4
 *   - the 2 outermost thumb keys on each side
 * The two encoder push-buttons (matrix positions 42/43) are kept alive
 * since they're hardware, not keys you can remove.
 * Only 36 keys carry real bindings on every layer.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define NAV  1
#define NUM  2
#define SYM  3

/ {
    behaviors {
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 44 45 46 47 48 49 55 56 57 58 59>;
            hold-trigger-on-release;
        };

        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 50 51 52 53 54>;
            hold-trigger-on-release;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <31 32>;
            bindings = <&kp ESC>;
        };

        combo_tab {
            timeout-ms = <50>;
            key-positions = <32 33>;
            bindings = <&kp TAB>;
        };

        combo_backspace {
            timeout-ms = <50>;
            key-positions = <27 28>;
            bindings = <&kp BACKSPACE>;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";
            bindings = <
&none  &none        &none        &none         &none    &none                                            &none      &none         &none        &none        &none          &none
&none  &kp Q        &kp W        &kp E         &kp R    &kp T                                            &kp Y      &kp U         &kp I        &kp O        &kp P          &none
&none  &hml LGUI A  &hml LALT S  &hml LCTRL D  &kp F    &kp G                                            &kp H      &hmr LCTRL J  &hmr RALT K  &hmr LGUI L  &kp SEMICOLON  &none
&none  &kp Z        &kp X        &kp C         &kp V    &kp B       &kp C_MUTE         &kp C_PLAY_PAUSE  &kp N      &kp M         &kp COMMA    &kp DOT      &kp FSLH       &none
                    &none        &none         &kp ESC  &lt 1 BSPC  &mt LSHFT SPACE    &lt 3 RET         &lt 2 DEL  &kp TAB       &none        &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        num_layer {
            display-name = "num/fn";
            bindings = <
&none  &none     &none   &none     &none     &none                          &none      &none     &none      &none     &none     &none
&none  &kp N1    &kp N2  &kp N3    &kp N4    &kp N5                         &kp N6     &kp N7    &kp N8     &kp N9    &kp N0    &none
&none  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT                      &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR  &kp RPAR  &none
&none  &kp F1    &kp F2  &kp F3    &kp F4    &kp F5     &kp F11    &kp F12  &kp F6     &kp F7    &kp F8     &kp F9    &kp F10   &none
                 &none   &none     &trans    &trans     &trans     &trans   &trans     &trans    &none      &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        nav_layer {
            display-name = "nav";
            bindings = <
&none  &none         &none         &none         &none           &none                           &none      &none     &none     &none      &none    &none
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3    &bt BT_SEL 4                    &kp PG_UP  &kp HOME  &kp UP    &kp END    &kp DEL  &none
&none  &bt BT_PRV    &bt BT_NXT    &bt BT_CLR    &bt BT_CLR_ALL  &out OUT_TOG                    &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &kp RET  &none
&none  &trans        &trans        &trans        &trans          &trans        &trans    &trans  &kp INS    &kp TAB   &trans    &trans     &trans   &none
                     &none         &none         &trans          &trans        &trans    &trans  &trans     &trans    &none     &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        sym_layer {
            display-name = "sym";
            bindings = <
&none  &none          &none      &none      &none      &none                       &none     &none     &none     &none     &none     &none
&none  &kp SQT        &kp GRAVE  &kp CARET  &kp TILDE  &kp DQT                     &kp LBKT  &kp RBKT  &kp LBRC  &kp RBRC  &kp BSLH  &none
&none  &kp RA(COMMA)  &kp MINUS  &kp UNDER  &kp EQUAL  &kp PLUS                    &kp LPAR  &kp RPAR  &kp PIPE  &kp LT    &kp GT    &none
&none  &trans         &trans     &trans     &trans     &trans    &trans    &trans  &trans    &trans    &trans    &trans    &trans    &none
                      &none      &none      &trans     &trans    &trans    &trans  &trans    &trans    &none     &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
